{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"Home","text":""},{"location":"#_1","title":"\u4f01\u4e1a\u6cd5\u4eba\u8425\u4e1a\u6267\u7167\u529e\u7406\u6d41\u7a0b\u4e0e\u4ee3\u529e\u9014\u5f84\u6307\u5357","text":"<p>\u5728\u5f53\u4eca\u77ac\u606f\u4e07\u53d8\u7684\u5546\u4e1a\u73af\u5883\u4e2d\uff0c\u521b\u529e\u4e00\u5bb6\u5c5e\u4e8e\u81ea\u5df1\u7684\u516c\u53f8\u662f\u65e0\u6570\u521b\u4e1a\u8005\u8fc8\u5411\u6210\u529f\u7684\u7b2c\u4e00\u6b65\u3002\u800c\u5728\u6574\u4e2a\u521b\u4e1a\u5f81\u9014\u4e2d\uff0c\u4f01\u4e1a\u6cd5\u4eba\u8425\u4e1a\u6267\u7167\u65e0\u7591\u662f\u83b7\u53d6\u5408\u6cd5\u7ecf\u8425\u8d44\u683c\u3001\u5efa\u7acb\u5e02\u573a\u4fe1\u4efb\u7684\u5b98\u65b9\u201c\u5165\u573a\u5238\u201d\u3002\u65e0\u8bba\u662f\u5165\u9a7b\u4e3b\u6d41\u7535\u5546\u5e73\u53f0\u3001\u7533\u8bf7\u94f6\u884c\u5bf9\u516c\u8d26\u6237\uff0c\u8fd8\u662f\u7b7e\u7f72\u91cd\u5927\u7684\u5546\u4e1a\u5408\u540c\uff0c\u5408\u6cd5\u5408\u89c4\u7684\u8425\u4e1a\u6267\u7167\u90fd\u662f\u4e0d\u53ef\u6216\u7f3a\u7684\u6cd5\u6cbb\u57fa\u77f3\u3002</p> <p></p> <p>\u5bf9\u4e8e\u4f17\u591a\u521d\u521b\u8005\u548c\u7ba1\u7406\u4eba\u5458\u800c\u8a00\uff0c\u9762\u5bf9\u7e41\u590d\u7684\u5de5\u5546\u767b\u8bb0\u653f\u7b56\uff0c\u5f80\u5f80\u4f1a\u5728\u201c\u81ea\u884c\u524d\u5f80\u7a97\u53e3\u529e\u7406\u201d\u4e0e\u201c\u5bfb\u627e\u4e13\u4e1a\u4e2d\u4ecb\u59d4\u6258\u4ee3\u529e\u201d\u4e4b\u95f4\u4e3e\u68cb\u4e0d\u5b9a\u3002\u672c\u6587\u5c06\u6df1\u5ea6\u4e3a\u60a8\u62c6\u89e3\u5f53\u4e0b\u6700\u6807\u51c6\u7684\u4f01\u4e1a\u6cd5\u4eba\u8425\u4e1a\u6267\u7167\u7533\u9886\u6d41\u7a0b\uff0c\u5e76\u5168\u9762\u8d77\u5e95\u7b2c\u4e09\u65b9\u4ee3\u529e\u7684\u5408\u89c4\u8def\u5f84\u4e0e\u907f\u5751\u6307\u5357\uff0c\u52a9\u60a8\u9ad8\u6548\u3001\u5b89\u5168\u5730\u5f00\u542f\u521b\u4e1a\u7b2c\u4e00\u6b65\u3002</p>"},{"location":"#_2","title":"\u4e00\u3001 \u516c\u53f8\u6ce8\u518c\u7f51\u4e0a\u7533\u8bf7\u6d41\u7a0b\uff1a\u6838\u5fc3\u6750\u6599\u51c6\u5907\u4e0e\u7ebf\u4e0a\u767b\u8bb0","text":"<p>\u968f\u7740\u5168\u56fd\u653f\u52a1\u670d\u52a1\u201c\u4e00\u7f51\u901a\u529e\u201d\u7684\u6df1\u5ea6\u666e\u53ca\uff0c\u76ee\u524d\u5927\u90e8\u5206\u7701\u5e02\u7684\u4f01\u4e1a\u8bbe\u7acb\u767b\u8bb0\u5747\u5df2\u5b9e\u73b0\u4e86\u5168\u6d41\u7a0b\u6570\u5b57\u5316\u3002\u901a\u8fc7\u4e92\u8054\u7f51\u5728\u7ebf\u63d0\u4ea4\u7533\u8bf7\uff0c\u5df2\u7ecf\u6210\u4e3a\u4f01\u4e1a\u767b\u8bb0\u7684\u4e3b\u6d41\u65b9\u5f0f\u3002</p>"},{"location":"#1","title":"1. \u6838\u5fc3\u6750\u6599\u51c6\u5907\u6e05\u5355","text":"<p>\u5728\u767b\u5f55\u5404\u7701\u5e02\u201c\u653f\u52a1\u670d\u52a1\u7f51\u201d\u6216\u201c\u5e02\u573a\u76d1\u7763\u7ba1\u7406\u5c40\u5b98\u7f51\u201d\u4e4b\u524d\uff0c\u521b\u59cb\u4eba\u987b\u63d0\u524d\u5907\u9f50\u4ee5\u4e0b\u6838\u5fc3\u8981\u4ef6\uff1a *   \u4f01\u4e1a\u540d\u79f0\uff1a\u5efa\u8bae\u51c6\u59073-5\u4e2a\u5907\u7528\u5b57\u53f7\uff0c\u4ee5\u9632\u6838\u540d\u5931\u8d25\u3002\u6807\u51c6\u7ed3\u6784\u4e3a\uff1a\u884c\u653f\u533a\u5212 + \u5b57\u53f7 + \u884c\u4e1a\u7279\u70b9 + \u7ec4\u7ec7\u5f62\u5f0f\uff08\u4f8b\u5982\uff1a\u5317\u4eac\u67d0\u67d0\u5546\u8d38\u6709\u9650\u516c\u53f8\uff09\u3002 *   \u4e3b\u4f53\u8eab\u4efd\u8bc1\u660e\uff1a\u6cd5\u5b9a\u4ee3\u8868\u4eba\u3001\u5168\u4f53\u80a1\u4e1c\u3001\u76d1\u4e8b\u53ca\u8d22\u52a1\u8d1f\u8d23\u4eba\u7684\u8eab\u4efd\u8bc1\u4ef6\u539f\u4ef6\u7167\u7247\u6216\u626b\u63cf\u4ef6\u3002 *   \u6ce8\u518c\u5730\u5740\u8bc1\u660e\uff1a\u63d0\u4f9b\u771f\u5b9e\u7684\u7ecf\u8425\u573a\u6240\u4ea7\u6743\u8bc1\u660e\u3001\u79df\u8d41\u534f\u8bae\uff1b\u5982\u82e5\u79df\u7528\u56ed\u533a\u5730\u5740\uff0c\u9700\u63d0\u4f9b\u56ed\u533a\u51fa\u5177\u7684\u6302\u9760\u8bc1\u660e\u6587\u4ef6\u3002 *   \u516c\u53f8\u7ae0\u7a0b\u4e0e\u7ecf\u8425\u8303\u56f4\uff1a\u6839\u636e\u81ea\u8eab\u4e3b\u8425\u4e1a\u52a1\uff0c\u53c2\u8003\u5b98\u65b9\u6807\u51c6\u89c4\u8303\u8868\u8ff0\u6765\u52fe\u9009\u6216\u62df\u5b9a\u7ecf\u8425\u8303\u56f4\u3002</p>"},{"location":"#2","title":"2. \u7ebf\u4e0a\u81ea\u4e3b\u7533\u62a5\u7684\u901a\u7528\u6b65\u9aa4","text":"<p>\u901a\u8fc7\u7535\u8111\u7aef\u6216\u624b\u673a\u653f\u52a1APP\u7533\u529e\uff0c\u5176\u6838\u5fc3\u6b65\u9aa4\u903b\u8f91\u53ef\u4ee5\u6982\u62ec\u4e3a\u4ee5\u4e0b\u56db\u4e2a\u5173\u952e\u8282\u70b9\uff1a 1.  \u540d\u79f0\u9884\u5148\u6838\u51c6\uff1a\u5728\u7ebf\u63d0\u4ea4\u4f01\u4e1a\u540d\u79f0\u7533\u8bf7\uff0c\u7cfb\u7edf\u901a\u8fc7\u5927\u6570\u636e\u6bd4\u5bf9\u5e93\u79d2\u7ea7\u6216\u5de5\u4f5c\u65e5\u5185\u53cd\u9988\u6838\u540d\u7ed3\u679c\u3002 2.  \u586b\u62a5\u8bbe\u7acb\u4fe1\u606f\uff1a\u6838\u540d\u901a\u8fc7\u540e\uff0c\u5728\u7ebf\u5f55\u5165\u6ce8\u518c\u8d44\u672c\u3001\u80a1\u4e1c\u51fa\u8d44\u6bd4\u4f8b\u3001\u9ad8\u7ba1\u4efb\u804c\u4fe1\u606f\u53ca\u7cbe\u786e\u7684\u7ecf\u8425\u8303\u56f4\u3002 3.  \u7ebf\u4e0a\u7535\u5b50\u7b7e\u540d\uff1a\u4fe1\u606f\u9884\u5ba1\u901a\u8fc7\u540e\uff0c\u7cfb\u7edf\u81ea\u52a8\u751f\u6210\u89c4\u8303\u7684\u7535\u5b50\u7533\u8bf7\u6750\u6599\uff0c\u6240\u6709\u5173\u8054\u81ea\u7136\u4eba\uff08\u6cd5\u4eba\u3001\u80a1\u4e1c\u7b49\uff09\u9700\u901a\u8fc7\u5b98\u65b9\u6307\u5b9a\u7684\u201c\u7535\u5b50\u8425\u4e1a\u6267\u7167\u5c0f\u7a0b\u5e8f\u201d\u6216APP\u5b8c\u6210\u4eba\u8138\u8bc6\u522b\u4e0e\u8fdc\u7a0b\u6570\u5b57\u8bc1\u4e66\u7b7e\u540d\u3002 4.  \u6838\u53d1\u5e76\u9886\u53d6\u6267\u7167\uff1a\u767b\u8bb0\u673a\u5173\u7ec8\u5ba1\u901a\u8fc7\u540e\uff0c\u7533\u8bf7\u4eba\u53ef\u9009\u62e9\u90ae\u5bc4\u6216\u524d\u5f80\u5b9e\u4f53\u7a97\u53e3\u9886\u7528\u7eb8\u8d28\u6b63\u526f\u672c\uff0c\u540c\u65f6\u53ef\u5728\u624b\u673a\u7aef\u540c\u6b65\u4e0b\u8f7d\u5177\u5907\u540c\u7b49\u6cd5\u5f8b\u6548\u529b\u7684\u7535\u5b50\u8425\u4e1a\u6267\u7167\u3002</p>"},{"location":"#vs","title":"\u4e8c\u3001 \u4e2a\u4eba\u53bb\u5de5\u5546\u5c40\u529e\u8425\u4e1a\u6267\u7167 vs \u59d4\u6258\u4e2d\u4ecb\uff1a\u54ea\u79cd\u6e20\u9053\u66f4\u9002\u5408\u4f60\uff1f","text":"<p>\u7a76\u7adf\u662f\u9009\u62e9\u81ea\u4e3b\u4eb2\u529b\u4eb2\u4e3a\uff0c\u8fd8\u662f\u652f\u4ed8\u4e00\u5b9a\u7684\u670d\u52a1\u8d39\u59d4\u6258\u7b2c\u4e09\u65b9\u4ee3\u529e\uff1f\u6211\u4eec\u9700\u8981\u4ece\u65f6\u95f4\u6210\u672c\u3001\u4e13\u4e1a\u95e8\u69db\u548c\u5408\u89c4\u5b89\u5168\u6027\u7b49\u591a\u4e2a\u7ef4\u5ea6\u8fdb\u884c\u5bf9\u6bd4\u3002</p> \u5bf9\u6bd4\u7ef4\u5ea6 \u81ea\u4e3b\u4eb2\u529b\u4eb2\u4e3a\u529e\u7406 \u7b2c\u4e09\u65b9\u6b63\u89c4\u4ee3\u529e\u673a\u6784 \u8d44\u91d1\u5f00\u9500 0\u5143\u5b98\u65b9\u89c4\u8d39\uff08\u4ec5\u9700\u81ea\u884c\u627f\u62c5\u4ea4\u901a\u6216\u6253\u5370\u8d39\uff09 \u9700\u652f\u4ed8\u51e0\u767e\u81f3\u4e0a\u5343\u5143\u4e0d\u7b49\u7684\u5408\u7406\u4ee3\u7406\u670d\u52a1\u8d39 \u65f6\u95f4\u4e0e\u7cbe\u529b \u9700\u8981\u81ea\u884c\u7814\u8bfb\u5de5\u5546\u3001\u7a0e\u52a1\u653f\u7b56\uff0c\u6781\u6613\u56e0\u6750\u6599\u9000\u56de\u800c\u53cd\u590d\u4fee\u6539 \u5168\u7a0b\u4e13\u4eba\u8ddf\u8fdb\uff0c\u6700\u5feb3-5\u4e2a\u5de5\u4f5c\u65e5\u5373\u53ef\u5b9e\u73b0\u5feb\u901f\u4e0b\u8bc1 \u5730\u5740\u4e0e\u8d44\u6e90 \u5fc5\u987b\u7531\u521b\u4e1a\u8005\u81ea\u5df1\u89e3\u51b3\u771f\u5b9e\u3001\u5408\u89c4\u7684\u5b9e\u5730\u7ecf\u8425\u573a\u6240 \u53ef\u9488\u5bf9\u65e0\u5730\u5740\u7684\u7535\u5546\u6216\u521d\u521b\u4f01\u4e1a\u63d0\u4f9b\u56ed\u533a\u5408\u89c4\u5408\u6cd5\u7684\u5730\u5740\u6302\u9760\u65b9\u6848 \u540e\u7eed\u8854\u63a5\u5ea6 \u6267\u7167\u5230\u624b\u540e\uff0c\u5bb9\u6613\u5ffd\u7565\u7a0e\u52a1\u62a5\u5230\u3001\u94f6\u884c\u5f00\u6237\u7b49\u540e\u7eed\u6cd5\u5b9a\u52a8\u4f5c \u901a\u5e38\u63d0\u4f9b\u201c\u5de5\u5546\u6ce8\u518c+\u4ee3\u7406\u8bb0\u8d26+\u7a0e\u52a1\u5408\u89c4\u201d\u7684\u4e00\u7ad9\u5f0f\u5168\u751f\u547d\u5468\u671f\u670d\u52a1 <p>\u5bf9\u4e8e\u4e1a\u52a1\u7ed3\u6784\u7b80\u5355\u3001\u81ea\u8eab\u5177\u5907\u4e00\u5b9a\u653f\u7b56\u7406\u89e3\u529b\u7684\u521b\u4e1a\u8005\uff0c\u81ea\u4e3b\u901a\u8fc7\u624b\u673a\u6216\u653f\u52a1\u7a97\u53e3\u529e\u7406\u662f\u6027\u4ef7\u6bd4\u8f83\u9ad8\u7684\u9009\u62e9\uff1b\u4f46\u5bf9\u4e8e\u6d89\u53ca\u591a\u4f4d\u80a1\u4e1c\u3001\u6ce8\u518c\u8d44\u672c\u8f83\u5927\u3001\u6216\u8005\u6025\u4e8e\u5728\u77ed\u65f6\u95f4\u5185\u62ff\u8bc1\u5bf9\u63a5\u4e1a\u52a1\u7684\u4f01\u4e1a\u6cd5\u4eba\uff0c\u9009\u62e9\u4e00\u5bb6\u5177\u5907\u8d44\u8d28\u7684\u7b2c\u4e09\u65b9\u4ee3\u529e\u673a\u6784\uff0c\u5f80\u5f80\u80fd\u5e2e\u4f01\u4e1a\u89c4\u907f\u56e0\u524d\u671f\u7ae0\u7a0b\u62df\u5b9a\u4e0d\u89c4\u8303\u800c\u57cb\u4e0b\u7684\u957f\u8fdc\u9690\u60a3\u3002</p>"},{"location":"#_3","title":"\u4e09\u3001 \u4ee3\u529e\u8425\u4e1a\u6267\u7167\u591a\u5c11\u94b1\uff1f\u5982\u4f55\u5408\u89c4\u59d4\u6258\u4e0e\u907f\u5751\u6307\u5357","text":"<p>\u5982\u679c\u786e\u5b9a\u9009\u62e9\u7b2c\u4e09\u65b9\u4ee3\u529e\uff0c\u521b\u4e1a\u8005\u5fc5\u987b\u660e\u786e\uff1a\u8425\u4e1a\u6267\u7167\u662f\u7531\u56fd\u5bb6\u5e02\u573a\u76d1\u7763\u7ba1\u7406\u90e8\u95e8\u4f9d\u6cd5\u9881\u53d1\u7684\uff0c\u4efb\u4f55\u58f0\u79f0\u53ef\u4ee5\u201c\u79c1\u81ea\u5236\u4f5c\u8bc1\u4ef6\u201d\u6216\u201c\u975e\u6b63\u89c4\u6e20\u9053\u5185\u90e8\u64cd\u4f5c\u201d\u7684\u5ba3\u4f20\u5747\u5c5e\u4e8e\u8fdd\u6cd5\u6b3a\u8bc8\u3002 \u5408\u89c4\u7684\u7b2c\u4e09\u65b9\u4ee3\u529e\uff0c\u672c\u8d28\u4e0a\u662f\u4f01\u4e1a\u4f9d\u6cd5\u59d4\u6258\u5408\u6cd5\u7684\u4ee3\u7406\u4eba\u8fdb\u884c\u884c\u653f\u5ba1\u6279\u7684\u534f\u52a9\u7533\u62a5\u3002</p>"},{"location":"#1_1","title":"1. \u89c4\u8303\u7684\u4ee3\u529e\u59d4\u6258\u6d41\u7a0b","text":"<p>\u4e00\u4efd\u5408\u89c4\u7684\u7b2c\u4e09\u65b9\u59d4\u6258\u4ee3\u7406\uff0c\u5176\u6cd5\u5f8b\u624b\u7eed\u5fc5\u987b\u4e25\u5bc6\uff1a *   \u7b7e\u7f72\u89c4\u8303\u7684\u300a\u59d4\u6258\u4ee3\u7406\u4eba\u8bc1\u660e\u300b\uff1a\u4f01\u4e1a\u6cd5\u5b9a\u4ee3\u8868\u4eba\u6216\u51fa\u8d44\u4eba\u5fc5\u987b\u7b7e\u7f72\u5b98\u65b9\u683c\u5f0f\u7684\u59d4\u6258\u4e66\uff0c\u660e\u786e\u6388\u6743\u4e2d\u4ecb\u673a\u6784\u7684\u4ee3\u529e\u6743\u9650\u4e0e\u671f\u9650\u3002 *   \u4ee3\u7406\u4eba\u8eab\u4efd\u6838\u9a8c\uff1a\u7ecf\u529e\u7684\u5de5\u5546\u987e\u95ee\u5728\u63d0\u4ea4\u6750\u6599\u65f6\uff0c\u5fc5\u987b\u540c\u65f6\u5411\u767b\u8bb0\u673a\u5173\u51fa\u793a\u81ea\u8eab\u7684\u8eab\u4efd\u8bc1\u4ef6\u53ca\u4ee3\u7406\u8d44\u8d28\u51ed\u8bc1\u3002 *   \u4e25\u7981\u4fe1\u606f\u4e70\u5356\u4e0e\u4f2a\u9020\uff1a\u5408\u89c4\u4ee3\u529e\u7edd\u4e0d\u610f\u5473\u7740\u6cd5\u4eba\u53ef\u4ee5\u5f7b\u5e95\u5931\u8054\uff0c\u5728\u8fdb\u884c\u201c\u5b9e\u540d\u8ba4\u8bc1\u201d\u548c\u201c\u7535\u5b50\u7b7e\u540d\u201d\u7b49\u89e6\u53ca\u6cd5\u5f8b\u8d23\u4efb\u7684\u6838\u5fc3\u73af\u8282\u65f6\uff0c\u4ecd\u9700\u6cd5\u4eba\u672c\u4eba\u4eb2\u81ea\u914d\u5408\u5237\u8138\u5b8c\u6210\u3002</p>"},{"location":"#2_1","title":"2. \u9009\u62e9\u4ee3\u529e\u670d\u52a1\u673a\u6784\u7684\u201c\u96f6\u5957\u8def\u201d\u907f\u5751\u51c6\u5219","text":"<p>\u9762\u5bf9\u5e02\u573a\u4e0a\u9c7c\u9f99\u6df7\u6742\u7684\u5de5\u5546\u4ee3\u7406\u516c\u53f8\uff0c\u8bf7\u52a1\u5fc5\u4e25\u628a\u4ee5\u4e0b\u4e09\u9053\u5173\u5361\uff1a *   \u6838\u67e5\u5b98\u65b9\u4e3b\u4f53\u8d44\u8d28\uff1a\u9996\u8981\u770b\u5176\u81ea\u8eab\u7684\u300a\u8425\u4e1a\u6267\u7167\u300b\u4e2d\uff0c\u7ecf\u8425\u8303\u56f4\u662f\u5426\u660e\u786e\u5305\u542b\u201c\u4f01\u4e1a\u767b\u8bb0\u4ee3\u7406\u201d\u3001\u201c\u5546\u52a1\u670d\u52a1\u201d\u6216\u201c\u8d22\u52a1\u54a8\u8be2\u201d\u3002\u4f18\u5148\u9009\u62e9\u6210\u7acb\u5e74\u9650\u957f\u3001\u5728\u672c\u5730\u5e02\u573a\u76d1\u7ba1\u90e8\u95e8\u6709\u826f\u597d\u5907\u6848\u8bb0\u5f55\u7684\u6b63\u89c4\u8d22\u52a1\u5e08\u4e8b\u52a1\u6240\u3002 *   \u8b66\u60d5\u201c\u4f4e\u4ef7/0\u5143\u201d\u6346\u7ed1\u5957\u8def\uff1a\u5e02\u573a\u4e0a\u6cdb\u6ee5\u7684\u201c\u4f4e\u4ef7\u5168\u5305\u201d\u751a\u81f3\u201c0\u5143\u514d\u8d39\u6ce8\u518c\u516c\u53f8\u201d\uff0c\u5176\u5e95\u5c42\u903b\u8f91\u901a\u5e38\u662f\u5f3a\u5236\u6346\u7ed1\u4e3a\u671f1-3\u5e74\u7684\u8d85\u957f\u4ee3\u7406\u8bb0\u8d26\u5408\u540c\u3002\u5728\u7b7e\u7ea6\u524d\uff0c\u5fc5\u987b\u8981\u6c42\u5bf9\u65b9\u51fa\u5177\u4e66\u9762\u7684\u3001\u4e00\u6b21\u6027\u62a5\u4ef7\u7684\u201c\u8d39\u7528\u6e05\u5355\u201d\uff0c\u660e\u786e\u662f\u5426\u5305\u542b\u540e\u7eed\u7684\u523b\u7ae0\u8d39\u3001\u94f6\u884c\u5f00\u6237\u534f\u52a9\u8d39\u3001\u4ee5\u53ca\u9690\u5f62\u7684\u5730\u5740\u7eed\u8d39\u7b49\u3002 *   \u62d2\u7edd\u865a\u5047/\u975e\u6cd5\u9ed1\u5730\u5740\uff1a\u82e5\u4f01\u4e1a\u4e0d\u5177\u5907\u5b9e\u4f53\u529e\u516c\u573a\u6240\u800c\u9009\u62e9\u5730\u5740\u6302\u9760\uff0c\u5fc5\u987b\u786e\u4fdd\u4ee3\u529e\u65b9\u63d0\u4f9b\u7684\u662f\u7531\u5f53\u5730\u653f\u5e9c\u6216\u7ecf\u5f00\u533a\u56ed\u533a\u6b63\u5f0f\u6279\u51c6\u7684\u3001\u5141\u8bb8\u6ce8\u518c\u7684\u201c\u4e91\u4e0a\u56ed\u533a\u7edf\u7b79\u5730\u5740\u201d\uff0c\u5207\u52ff\u91c7\u7528\u591a\u6237\u4e00\u5ba4\u3001\u865a\u5047\u7f16\u9020\u7684\u201c\u9ed1\u5730\u5740\u201d\uff0c\u5426\u5219\u6781\u6613\u5bfc\u81f4\u4f01\u4e1a\u521a\u6210\u7acb\u5c31\u88ab\u5217\u5165\u201c\u5de5\u5546\u5f02\u5e38\u540d\u5f55\u201d\u3002</p>"},{"location":"#_4","title":"\u56db\u3001 \u65b0\u529e\u8425\u4e1a\u6267\u7167\u540e\u7eed\u6ce8\u610f\u4e8b\u9879\uff1a\u62ff\u8bc1\u540e\u7684\u5408\u89c4\u7ea2\u7ebf","text":"<p>\u5f88\u591a\u521d\u521b\u5c0f\u767d\u8bef\u4ee5\u4e3a\u62ff\u5230\u4f01\u4e1a\u6cd5\u4eba\u8425\u4e1a\u6267\u7167\u5c31\u4e07\u4e8b\u5927\u5409\u4e86\uff0c\u5176\u5b9e\uff0c\u65b0\u516c\u53f8\u5408\u89c4\u8fd0\u8425\u7684\u8003\u9a8c\u624d\u521a\u521a\u5f00\u59cb\u3002\u4ee5\u4e0b\u4e09\u9879\u5de5\u4f5c\u5728\u6267\u7167\u7b7e\u53d1\u540e\u5177\u6709\u5f3a\u70c8\u7684\u65f6\u6548\u6027\uff1a</p> <ol> <li>\u6cd5\u5b9a\u523b\u7ae0\u4e0e\u5f00\u6237\uff1a\u51ed\u8425\u4e1a\u6267\u7167\u5230\u516c\u5b89\u5c40\u6307\u5b9a\u7684\u523b\u7ae0\u70b9\u523b\u5236\u516c\u7ae0\u3001\u6cd5\u4eba\u7ae0\u3001\u8d22\u52a1\u4e13\u7528\u7ae0\u548c\u53d1\u7968\u4e13\u7528\u7ae0\uff0c\u5e76\u53ca\u65f6\u524d\u5f80\u94f6\u884c\u5f00\u8bbe\u4f01\u4e1a\u5bf9\u516c\u57fa\u672c\u8d26\u6237\u3002</li> <li>\u4e09\u5341\u65e5\u5185\u7a0e\u52a1\u62a5\u5230\uff1a\u6839\u636e\u6211\u56fd\u7a0e\u52a1\u53ca\u300a\u5e02\u573a\u4e3b\u4f53\u767b\u8bb0\u7ba1\u7406\u6761\u4f8b\u300b\u7b49\u76f8\u5173\u6cd5\u89c4\uff0c\u4f01\u4e1a\u5728\u9886\u53d6\u8425\u4e1a\u6267\u7167\u540e\uff0c\u5e94\u572830\u65e5\u5185\u524d\u5f80\u7a0e\u52a1\u673a\u5173\u529e\u7406\u7a0e\u52a1\u62a5\u5230\uff0c\u6838\u5b9a\u7a0e\u79cd\u3002\u5373\u4fbf\u516c\u53f8\u524d\u671f\u6ca1\u6709\u4efb\u4f55\u8425\u4e1a\u6536\u5165\uff0c\u4e5f\u5fc5\u987b\u4f9d\u6cd5\u8fdb\u884c\u6bcf\u6708\u7684\u96f6\u7533\u62a5\uff0c\u5426\u5219\u5c06\u9762\u4e34\u7f5a\u6b3e\u751a\u81f3\u540a\u9500\u6267\u7167\u7684\u4e25\u91cd\u5904\u7f5a\u3002</li> <li>\u6309\u65f6\u5c65\u884c\u4f01\u4e1a\u5e74\u62a5\u4e49\u52a1\uff1a\u6bcf\u5e741\u67081\u65e5\u81f36\u670830\u65e5\uff0c\u4f01\u4e1a\u5fc5\u987b\u901a\u8fc7\u201c\u56fd\u5bb6\u4f01\u4e1a\u4fe1\u7528\u4fe1\u606f\u516c\u793a\u7cfb\u7edf\u201d\u5411\u793e\u4f1a\u516c\u793a\u4e0a\u4e00\u5e74\u5ea6\u7684\u5e74\u5ea6\u62a5\u544a\uff08\u5305\u542b\u8d44\u4ea7\u72b6\u51b5\u3001\u7ecf\u8425\u72b6\u6001\u3001\u793e\u4fdd\u7f34\u7eb3\u7b49\uff09\u3002\u672a\u6309\u65f6\u5e74\u62a5\u7684\u4f01\u4e1a\u5c06\u88ab\u76f4\u63a5\u62c9\u5165\u7ecf\u8425\u5f02\u5e38\u540d\u5f55\uff0c\u5bf9\u6cd5\u4eba\u7684\u4e2a\u4eba\u5f81\u4fe1\u4ea7\u751f\u6781\u5927\u8d1f\u9762\u5f71\u54cd\u3002</li> </ol>"},{"location":"#_5","title":"\u603b\u7ed3","text":"<p>\u9009\u62e9\u81ea\u4e3b\u7ebf\u4e0a\u7533\u62a5\uff0c\u80fd\u591f\u8ba9\u60a8\u6df1\u5165\u4f53\u9a8c\u56fd\u5bb6\u201c\u653e\u7ba1\u670d\u201d\u6539\u9769\u5e26\u6765\u7684\u6570\u5b57\u4fbf\u5229\uff0c\u7701\u94b1\u53c8\u900f\u660e\uff1b\u800c\u9009\u62e9\u5408\u89c4\u7684\u7b2c\u4e09\u65b9\u4ee3\u529e\u9014\u5f84\uff0c\u5219\u80fd\u7528\u5408\u7406\u7684\u8d44\u91d1\u6362\u53d6\u4e13\u4e1a\u7684\u65f6\u95f4\u7ea2\u5229\uff0c\u8ba9\u60a8\u628a\u9ec4\u91d1\u7cbe\u529b\u7cbe\u51c6\u6295\u6ce8\u5230\u6838\u5fc3\u4e1a\u52a1\u7684\u5f00\u62d3\u4e4b\u4e2d\u3002\u65e0\u8bba\u60a8\u91c7\u7528\u54ea\u79cd\u65b9\u5f0f\uff0c\u4f9d\u6cd5\u4f9d\u89c4\u3001\u8bda\u4fe1\u7b03\u884c\uff0c\u65b9\u80fd\u9a7e\u9a6d\u4f01\u4e1a\u4e4b\u821f\u5728\u5546\u6d77\u4e2d\u626c\u5e06\u8fdc\u822a\u3002\u5370\u8bc1\uff0c\u6784\u6210\u4e86\u5b8c\u6574\u7684\u8de8\u5883\u6c11\u4e8b\u6587\u4e66\u8fa8\u8bc6\u4e0e\u4fe1\u4efb\u94fe\u6761\u3002</p>"}]}